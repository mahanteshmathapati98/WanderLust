<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="alert alert-danger shadow text-center p-5" role="alert">
            <h1 class="display-4 fw-bold">Oops! 😕</h1>

        <h4 class="mt-3">Something went wrong</h4>

        <p class="mt-3 mb-4"> <%= message %> <br>
            We couldn't find the page or listing you're looking for.
        </p>

        <a href="/listings" class="btn btn-dark">
            ← Back to Listings
        </a>
    </div>
</div>

</div>
